{
  "name": "biblioteca-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API RESTful de biblioteca digital con Express, TypeScript y MongoDB",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --project tsconfig.tests.json",
    "start": "node dist/index.js",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "mongoose": "9.12.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
